rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /checklists/{cid} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      match /families/{fid} {
        function isOwner() {
          return request.auth != null
            && get(/databases/$(database)/documents/checklists/$(cid)).data.ownerUid == request.auth.uid;
        }
        allow read: if true;
        allow create, delete: if isOwner();
        allow update: if isOwner()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticks', 'updatedAt'])
              && request.resource.data.ticks is map);
      }
    }
  }
}
